PORT=8000
ENVIRONMENT=development
CLIENT_URL=http://localhost:5173
# Optional regex for Vercel preview deployments; keep it scoped to your project/team.
VERCEL_PREVIEW_ORIGIN_REGEX=
SESSION_SECRET=change-this-to-a-long-random-string

# Database
MONGODB_URI=mongodb+srv://SynapseAI:yourActualPassword@synapse.y6ldl9r.mongodb.net/SynapseAI?retryWrites=true&w=majority
MONGODB_DATABASE=SynapseAI

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM=your-email@gmail.com

# AI & Embeddings
GROQ_API_KEY=your-groq-api-key
# Optional extra keys (comma-separated). On a rate limit, each model is tried on every key
# before moving to the next model in GROQ_FALLBACK_MODELS.
GROQ_API_KEYS=

# Supabase Vector Store
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-database-password@your-session-pooler-host:5432/postgres
SUPABASE_VECTOR_DIMENSIONS=384
VECTOR_STORE=supabase

# Upload limits (served to the frontend at /api/documents/config)
MAX_UPLOAD_MB=10
MAX_ATTACHMENTS=5
# Files the browser uploads in parallel
UPLOAD_CONCURRENCY=3
# Parallel image-description (vision) requests per upload
RAG_IO_WORKERS=6
# Load the embedding model and OCR engine at startup so the first upload is fast
PRELOAD_MODELS=true

# AI models. When the main model hits Groq's per-minute limit, requests move to the
# next fallback model instead of waiting ~40s. Leave empty to disable fallbacks.
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Quiz/flashcard generation: output token budget and source text size (characters)
STUDY_MAX_TOKENS=2000
STUDY_CONTEXT_CHARS=18000
# Max Postgres connections the backend opens to Supabase
SUPABASE_POOL_SIZE=10

# Admins: these emails get the admin role automatically when they sign up or log in
# (comma-separated). Admins can also promote/demote users from the Admin dashboard.
ADMIN_EMAILS=
# Public frontend address used in email buttons/links (defaults to the first CLIENT_URL)
APP_URL=
# Shown in the "account deleted" email (defaults to SMTP_FROM)
SUPPORT_EMAIL=
# Verification codes (registration, password reset, account deletion)
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=5
# Rows per list in the Admin dashboard (search narrows results further)
ADMIN_LIST_LIMIT=200
